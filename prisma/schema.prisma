// Prisma schema for Tourism Intelligence Platform
// Note: PostGIS geography type requires raw SQL for some operations

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EntityType {
  RESTAURANT
  HOTEL
  GUIDE
  TRANSPORT
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  TRUSTED
  FLAGGED
}

model Place {
  id                  String   @id @default(uuid())
  name                String
  entityType          EntityType
  location            Unsupported("geography(Point, 4326)") // PostGIS geography type
  address             String
  verificationStatus  VerificationStatus @default(UNVERIFIED)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  priceObservations   PriceObservation[]
  intelligenceProfile IntelligenceProfile?
  popVerifications    PopVerification[]
  travelAdvisory      TravelAdvisory?
  priceSubmissions    PriceSubmission[]
  merchantProfile     MerchantProfile?

  @@index([entityType])
  @@index([verificationStatus])
}

model PriceObservation {
  id          String   @id @default(uuid())
  placeId     String
  place       Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  itemName    String
  category    String
  reportedPrice Decimal  @db.Decimal(10, 2)
  isVerified  Boolean  @default(false)
  recordedAt  DateTime @default(now())

  @@index([placeId])
  @@index([category])
  @@index([recordedAt])
}

model IntelligenceProfile {
  placeId          String   @id
  place            Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  safetyScore      Decimal  @db.Decimal(4, 2) // 0.00 to 10.00
  positiveHighlights String[] @default([]) @db.Text
  thingsToKnow     String[] @default([]) @db.Text
  confidenceLevel  Int      @default(50) // 0-100
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ════════════════════════════════════════════════════════════════
// PART 2+3: PoP Verification, Advisory, Price Submission, Merchant
// ════════════════════════════════════════════════════════════════

model PopVerification {
  id                String   @id @default(uuid())
  userId            String
  placeId           String
  place             Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  userLat           Float
  userLng           Float
  targetLat         Float
  targetLng         Float
  distanceMeters    Int
  isVerified        Boolean
  status            String   // VERIFIED | OUT_OF_RANGE | INVALID_INPUT | EXPIRED
  verificationToken String   @unique
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  @@index([placeId])
  @@index([userId])
  @@index([verificationToken])
}

model TravelAdvisory {
  id                 String   @id @default(uuid())
  placeId            String   @unique
  place              Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  positiveHighlights String[] @db.Text
  thingsToKnow       String[] @db.Text
  riskLevel          String   // LOW | MEDIUM | HIGH
  confidenceScore    Float    // 0-1
  reasoning          String
  generatedAt        DateTime @default(now())
  validUntil         DateTime

  @@index([placeId])
}

model PriceSubmission {
  id            String    @id @default(uuid())
  placeId       String
  place         Place     @relation(fields: [placeId], references: [id], onDelete: Cascade)
  touristId     String    // Can be anonymous ID or auth user
  itemName      String
  category      String
  reportedPrice Decimal   @db.Decimal(10, 2)
  popVerified   Boolean
  popDistance    Int
  userComment   String?
  photoUrl      String?
  isVerified    Boolean   @default(false) // Merchant verification
  submittedAt   DateTime  @default(now())
  verifiedAt    DateTime?

  @@index([placeId])
  @@index([touristId])
  @@index([submittedAt])
}

model MerchantProfile {
  id              String    @id @default(uuid())
  userId          String    @unique
  placeId         String    @unique
  place           Place     @relation(fields: [placeId], references: [id], onDelete: Cascade)
  businessName    String
  email           String
  phone           String
  accountStatus   String    @default("PENDING") // PENDING | VERIFIED | SUSPENDED | INACTIVE
  businessLicense String
  taxId           String
  ownershipProof  String
  onboardedAt     DateTime  @default(now())
  verifiedAt      DateTime?

  @@index([userId])
  @@index([accountStatus])
}